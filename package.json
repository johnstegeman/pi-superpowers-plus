  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "check": "biome check . && tsc --noEmit && vitest run",
    "check:types": "tsc --noEmit"
  },
  "license": "MIT",
  "author": "coctostan",
  "repository": {
    "type": "git",
    "url": "https://github.com/coctostan/pi-superpowers-plus.git"
  },
  "files": [
    "extensions/",
    "agents/",
    "skills/",
    "banner.jpg",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "extensions/plan-tracker.ts",
      "extensions/workflow-monitor.ts",
      "extensions/subagent/index.ts"
